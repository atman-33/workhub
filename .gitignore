/target
/src-tauri/target
/node_modules
/dist
app-icon.png
tsconfig.tsbuildinfo

# Serena is treated as a personal tool; its configuration and memories are not shared.
/.serena/

# vault-template opencode runtime: per-vault artifacts only
vault-template/.opencode/node_modules/
vault-template/.opencode/.claude-plugin-sync-manifest.json

# demo-vault: the runtime artifacts the app writes while screenshots are taken.
# The vault's content is tracked; its machine state is not.
demo-vault/_ai/comms/*
demo-vault/_ai/index/*
demo-vault/_ai/logs/*
demo-vault/_ai/memory/*
!demo-vault/_ai/*/.gitkeep
demo-vault/_ai/template-manifest.json
demo-vault/_ai/music/
demo-vault/.obsidian/
demo-vault/.opencode/
# Written from this machine's own config while demo mode is on: the real
# repository list and the real vault settings would land here otherwise.
demo-vault/.workhub/
demo-vault/.claude/project-context.json
demo-vault/opencode.json
# Ink captures are pictures of whatever was on screen.
demo-vault/attachments/ink/
