filters:
  and:
    - 'type == "backlog"'
    - file.inFolder("backlog")

formulas:
  prio_rank: 'if(priority == "high", 1, if(priority == "medium", 2, 3))'

properties:
  status:
    displayName: Status
  priority:
    displayName: Priority
  source:
    displayName: "External backlog"

views:
  - type: table
    name: "Open"
    filters:
      and:
        - 'status != "done"'
        - 'status != "dropped"'
    order:
      - file.name
      - status
      - priority
      - source
    groupBy:
      property: status
      direction: ASC

  - type: table
    name: "Closed"
    filters:
      or:
        - 'status == "done"'
        - 'status == "dropped"'
    order:
      - file.name
      - status
